# Copy this file to  .streamlit/secrets.toml  and fill in your values.
# Local login uses SSO via the external browser (no password stored here).

[connections.snowflake]
account = "AMLANDG-DEV"            # your DEV account locator/identifier
# PrivateLink: point at the privatelink host so traffic stays on the private
# endpoint. The `host` overrides the default *.snowflakecomputing.com URL.
host = "amlandg-dev.privatelink.snowflakecomputing.com"
user = "CILLIAN.KEATING@LGIM.COM"
authenticator = "externalbrowser"
role = "DATA_ENGINEERING_HOME_PRODUCER_ROLE"
warehouse = "ENGINEERING_WH"
database = "DATA_ENGINEERING_HOME"          # database that holds the agent
schema = "CILLIAN_TEST"                     # schema that holds the agent

# Details of the Cortex Agent to call. These point the app at your agent
# object created in the DEV environment.
[agent]
name = "DATA_DISCOVERY_AGENT"
database = "DATA_ENGINEERING_HOME"          # database the agent object lives in
schema = "CILLIAN_TEST"                     # schema the agent object lives in
